#include<bits/stdc++.h>
using namespace std;
int main()
{
    long long n;
    cout<<"enter";
    cin>>n;
    if(n <= 1)
    {
        cout << "Not Prime";
    }

    else if(n == 2 || n == 3 || n == 5)
    {
        cout << "Prime";
    }
    else if(n % 2 == 0 || n % 3 == 0 || n % 5 == 0)
    {
        cout << "Not Prime";
    }


    else
    {
        int flag=0;
        for(int i=7;i*i<=n;i=i+2)
        {
            if(n%i==0)
            {
                flag=1;
                break;
            }
        }
        if(flag==1)
        {
            cout<<"not prime";
        }
        else
        {
            cout<<"prime";
        }
    }
    return 0;
}
