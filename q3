#include<bits/stdc++.h>
using namespace std;
int main()
{
    long long n;
    cout<<"enter";
    cin>>n;
    int ans;
    long long u=n,l=0,mid;
    while(l<=u)
    {
        mid=(l+u)/2;
        if(mid<=n/mid)
        {
            ans=mid;
            l=mid+1;
        }
        else
        {
            u=mid-1;
        }
    }
    cout << "Square root = " << ans;
    return 0;
}
