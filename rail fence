#include <bits/stdc++.h>
using namespace std;

string decryptRailFence(string cipher, int key) {
    int n = cipher.size();

    vector<vector<char>> rail(key, vector<char>(n, '\n'));

    // Step 1: mark zigzag pattern
    bool dir_down = false;
    int row = 0, col = 0;

    for (int i = 0; i < n; i++) {
        if (row == 0 || row == key - 1)
            dir_down = !dir_down;

        rail[row][col++] = '*';

        row += dir_down ? 1 : -1;
    }

    // Step 2: fill ciphertext in marked positions
    int index = 0;
    for (int i = 0; i < key; i++) {
        for (int j = 0; j < n; j++) {
            if (rail[i][j] == '*' && index < n)
                rail[i][j] = cipher[index++];
        }
    }

    // Step 3: read in zigzag order
    string result = "";
    row = 0, col = 0;
    dir_down = false;

    for (int i = 0; i < n; i++) {
        if (row == 0 || row == key - 1)
            dir_down = !dir_down;

        result += rail[row][col++];

        row += dir_down ? 1 : -1;
    }

    return result;
}

int main() {
    string cipher = "HOLELWRDLO";
    int key = 3;

    cout << decryptRailFence(cipher, key);
}
