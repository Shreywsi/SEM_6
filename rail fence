#include <bits/stdc++.h>
using namespace std;

void encryptRailFence(string text, int key)
{
    vector<string> rail(key);

    int dir = 1, row = 0;

    for (char c : text)
    {
        rail[row] += c;

        row += dir;

        if (row == 0 || row == key - 1)
            dir = -dir;
    }

    string cipher = "";
    for (string r : rail)
        cipher += r;

    cout << "Cipher Text: " << cipher << endl;
}

int main()
{
    string text;
    int key;

    cout << "Enter text: ";
    cin >> text;

    cout << "Enter key: ";
    cin >> key;

    encryptRailFence(text, key);

    return 0;
}
